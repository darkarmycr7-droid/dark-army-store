# ---- Dark-Army Store backend ----
# Dev uses SQLite (zero setup). For production swap to PostgreSQL:
#   provider = "postgresql" in prisma/schema.prisma  AND
#   DATABASE_URL="postgresql://user:pass@localhost:5432/darkarmy?schema=public"
DATABASE_URL="file:./dev.db"

PORT=4000
# Comma-separated list of allowed storefront origins
CORS_ORIGIN="http://localhost:3200"

# CHANGE THIS in production
JWT_SECRET="dev-only-change-me-please-32-chars-min"
JWT_EXPIRES_IN="7d"

# Storage driver: "local" (default) or "s3"
STORAGE_DRIVER="local"
PUBLIC_BASE_URL="http://localhost:4000"

# Payments: comma list of enabled methods. Real KNET/card need live creds.
# Supported now: COD (cash on delivery), STUB (sandbox card simulator)
PAYMENT_METHODS="COD,STUB"

# ---- Email (for account verification) ----
# EMAIL_DRIVER: "console" (dev — prints the code to the server log) or "smtp" (real)
EMAIL_DRIVER="console"
MAIL_FROM="Dark-Army Store <no-reply@darkarmy.store>"
# Require customers to verify their email before they can sign in / order
REQUIRE_EMAIL_VERIFICATION="true"
OTP_TTL_MINUTES="10"
# SMTP settings (only used when EMAIL_DRIVER=smtp)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Automated backups (SQLite). Hours between auto-backups (0 = off).
# Manual backup anytime: npm run backup  → writes to backend/backups/
BACKUP_INTERVAL_HOURS="0"
BACKUP_KEEP="14"

# Store config
STORE_NAME="Dark-Army Store"
CURRENCY="KD"
TAX_PCT="0"
FREE_SHIPPING_OVER="20"
DEFAULT_SHIPPING="1.5"
