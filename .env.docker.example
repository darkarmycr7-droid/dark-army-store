# Copy this file to ".env" (same folder as docker-compose.yml) and edit before:
#   docker compose up -d --build
# Docker Compose loads ".env" automatically.

# ---- Database ----
POSTGRES_USER=darkarmy
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_DB=darkarmy

# ---- Security (CHANGE THESE) ----
# Use a long random string (e.g. `openssl rand -base64 48`)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Public URL customers use (used for CORS, uploaded image URLs, sitemap)
PUBLIC_URL=http://your-server-ip-or-domain

# ---- First run ----
# true ONLY for the very first `up` (creates sample data + admin account).
# Change to false afterwards so restarts don't overwrite your catalog edits.
SEED_ON_START=true

# ---- Store ----
STORE_NAME=Dark-Army Store
PAYMENT_METHODS=COD,STUB
FREE_SHIPPING_OVER=20
DEFAULT_SHIPPING=1.5

# ---- Email (verification / reset / order notifications) ----
# console = log codes to the backend container log (dev/testing).
# smtp    = send real email (fill the SMTP_* values below).
EMAIL_DRIVER=console
REQUIRE_EMAIL_VERIFICATION=true
MAIL_FROM=Dark-Army Store <no-reply@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
