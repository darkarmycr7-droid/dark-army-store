# ---- Dark-Army Store frontend ----
# Copy to .env.local before the first run:  cp .env.local.example .env.local

# NEXT_PUBLIC_API_URL intentionally left unset so the frontend auto-detects the
# API host from the browser URL (see lib/apiBase.ts). This makes LAN sharing work:
# open http://<your-lan-ip>:3200 on any device and it calls <your-lan-ip>:4000.
# Set it explicitly only for production / a custom API domain.
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_STORE_NAME=Dark-Army Store
NEXT_PUBLIC_FREE_SHIPPING_OVER=20
NEXT_PUBLIC_SITE_URL=http://localhost:3200
# Your WhatsApp business number (Kuwait: 965 + 8 digits, no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=96500000000
